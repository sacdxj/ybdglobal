# Copy this file to .env.local and replace placeholder values.
# Astro exposes browser-safe variables with the PUBLIC_ prefix.

# Formspree form ID
PUBLIC_FORMSPREE_ID=your_formspree_id_here

# Canonical production site URL, used for structured data and share metadata.
PUBLIC_SITE_URL=https://connectivity-supply.invalid

# Optional Cloudflare Turnstile site key. Leave blank to disable the widget.
PUBLIC_TURNSTILE_SITE_KEY=

# Public contact settings
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# Private beta mode defaults to noindex. Set to false only after launch gates are approved.
PUBLIC_NOINDEX=true
