---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
  keywords?: string;
  publicationStatus?: string;
}

const isPrivateReview = import.meta.env.PUBLIC_NOINDEX === 'true';
const { title, description, image, canonical, type, keywords } = Astro.props;
const noindex = isPrivateReview || Astro.props.noindex === true || Astro.props.publicationStatus !== 'published';
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-M6PD9TNJ');
    </script>
    <!-- End Google Tag Manager -->
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      noindex={noindex}
      keywords={keywords}
    />
  <link rel="stylesheet" href="/styles/site.css?v=131" />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M6PD9TNJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <a class="whatsapp-float" href="https://wa.me/8613613046291?text=Hi%20YBD%20Global%2C%20I%20would%20like%20to%20ask%20about%20your%20USB%2C%20HDMI%2C%20DisplayPort%20or%20charger%20products." target="_blank" rel="noopener noreferrer" data-whatsapp-cta data-whatsapp-source="floating" aria-label="Chat with YBD Global on WhatsApp"><span class="whatsapp-float__icon" aria-hidden="true"></span><span class="whatsapp-float__label">WhatsApp</span></a>
  </body>
</html>
