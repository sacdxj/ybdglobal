---
const currentPath = Astro.url.pathname;
const navItems = [
  { href:'/products/', label:'Products', submenu:[
    {href:'/products/usb-cables/',label:'USB Cables'}, {href:'/products/hdmi-cables/',label:'HDMI Cables'},
    {href:'/products/displayport-cables/',label:'DisplayPort Cables'}, {href:'/products/hubs-docking/',label:'Hubs & Docking'},
    {href:'/products/chargers/',label:'Chargers'} ]},
  { href:'/oem-odm/', label:'Customization' },
  { href:'/quality-factory/', label:'Manufacturing' },
  { href:'/about-us/', label:'About Us' },
  { href:'/contact/', label:'Contact' },
];
---
<header class="site-header">
  <div class="announcement"><span>Built for B2B sourcing</span><span>Specifications before claims</span><span>Customization reviewed by project</span></div>
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label="Dongguan Youboda Technology Development Co., Ltd. home"><span class="brand__mark">YB</span><span class="brand__text">Youboda Technology</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navItems.map(item => {const active=currentPath===item.href||currentPath.startsWith(item.href);return <div class="nav-item"><a class:list={['nav-link',{'is-active':active}]} aria-current={active?'page':undefined} href={item.href}>{item.label}</a>{item.submenu&&<div class="submenu">{item.submenu.map(sub=><a aria-current={currentPath===sub.href?'page':undefined} href={sub.href}>{sub.label}</a>)}</div>}</div>})}
    </nav>
    <a class="header-cta" href="/get-a-quote/">Request a Quote</a>
  </div>
  <nav class="mobile-nav" aria-label="Mobile navigation">{navItems.map(item=>{const active=currentPath===item.href||currentPath.startsWith(item.href);return <a aria-current={active?'page':undefined} href={item.href}>{item.label}</a>})}</nav>
</header>
