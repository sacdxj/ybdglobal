<section class="rfq-workbench" aria-labelledby="rfq-title" data-rfq-form>
  <header class="rfq-workbench__intro">
    <div class="rfq-workbench__headline">
      <div class="rfq-pill-badge">
        <span class="rfq-pill-badge__dot"></span>
        <span>Direct Sourcing Gateway</span>
      </div>
      <h2 id="rfq-title">Build a Quote-Ready Requirement</h2>
      <p>Configure known project parameters below. Technical tolerances, certification scopes and custom packaging can remain open for review.</p>
    </div>
    <div class="rfq-status">
      <div class="rfq-status__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </div>
      <div class="rfq-status__body">
        <span class="rfq-status__tag">Direct Intake</span>
        <strong>Engineering & Pricing Review</strong>
        <small>Encrypted via Formspree · Reviewed within 24 business hours · See <a href="/privacy/">Privacy Notice</a></small>
      </div>
    </div>
  </header>

  <section class="rfq-prefill" data-rfq-prefill hidden aria-live="polite">
    <div>
      <p class="section-label">Custom solution request</p>
      <h3>Requirements carried over from your selected sourcing path.</h3>
    </div>
    <dl>
      <div><dt>Program</dt><dd data-prefill-program></dd></div>
      <div><dt>Product scope</dt><dd data-prefill-connection></dd></div>
      <div><dt>Customization</dt><dd data-prefill-customization></dd></div>
    </dl>
  </section>

  <form class="rfq-form" action="https://formspree.io/f/xnpqwpzg" method="POST" novalidate>
    <input type="hidden" name="_subject" value="New YBD Global RFQ request" />
    <input type="hidden" name="source" />
    <input type="hidden" name="program" value="Direct product sourcing" />
    <input type="hidden" name="stage" value="Need quotation" />
    <input type="hidden" name="connection" />
    <input type="hidden" name="performance" />
    <input type="hidden" name="customization" />
    <input type="hidden" name="evidence" />
    <input type="hidden" name="sample" value="Not specified" />
    <textarea name="message" hidden></textarea>
    <fieldset>
      <legend>
        <span class="legend-badge">01</span>
        <div class="legend-text">
          <strong>Project & Product Specifications</strong>
          <small>Connector configurations, electrical targets and order volumes</small>
        </div>
      </legend>
      <div class="rfq-grid">
        <label>
          <span class="label-title">Product family <strong class="req-star" aria-hidden="true">*</strong></span>
          <select name="family" required>
            <option value="">Select a product family</option>
            <option>USB Cable</option>
            <option>HDMI Cable</option>
            <option>DisplayPort Cable</option>
            <option>Hub / Dock</option>
            <option>Charger</option>
          </select>
        </label>
        <label>
          <span class="label-title">Reference SKU / Link / Model</span>
          <input name="product" autocomplete="off" placeholder="e.g. Model, reference link, photo name, or open recommendation" />
        </label>
        <label class="rfq-span-2">
          <span class="label-title">Requirements & Technical Scope <strong class="req-star" aria-hidden="true">*</strong></span>
          <textarea name="notes" rows="4" required placeholder="Example: USB-C to USB-C cable, 1.2m, PD 100W, 20Gbps data, braided nylon jacket, black, custom logo laser engraving, need 5 golden samples before trial production."></textarea>
        </label>
        <label>
          <span class="label-title">Initial Order / Trial Quantity <strong class="req-star" aria-hidden="true">*</strong></span>
          <input name="quantity" required inputmode="numeric" placeholder="e.g. 500 pcs trial / 5,000 pcs bulk" />
        </label>
        <label>
          <span class="label-title">Destination Market / Country <strong class="req-star" aria-hidden="true">*</strong></span>
          <input name="destination" required autocomplete="country-name" placeholder="e.g. United States, Germany, Japan" />
        </label>
        <label class="rfq-span-2">
          <span class="label-title">Customization & Certification Details</span>
          <textarea name="details" rows="3" placeholder="Target delivery window, destination certifications (CE/RoHS/FCC), retail gift box / polybag packaging, or target unit price expectations"></textarea>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>
        <span class="legend-badge">02</span>
        <div class="legend-text">
          <strong>Procurement Contact Information</strong>
          <small>Direct coordinates for sending formal quotes and spec sheets</small>
        </div>
      </legend>
      <div class="rfq-grid">
        <label>
          <span class="label-title">Company / Organization</span>
          <input name="company" autocomplete="organization" placeholder="e.g. Apex Tech Brands Ltd." />
        </label>
        <label>
          <span class="label-title">Contact Name <strong class="req-star" aria-hidden="true">*</strong></span>
          <input name="buyer" required autocomplete="name" placeholder="Full name or sourcing officer" />
        </label>
        <label>
          <span class="label-title">Corporate Email <strong class="req-star" aria-hidden="true">*</strong></span>
          <input name="email" type="email" required autocomplete="email" placeholder="name@company.com" />
        </label>
        <label>
          <span class="label-title">Direct Phone / WhatsApp / WeChat</span>
          <input name="phone" autocomplete="tel" placeholder="+1 (555) 019-2834 or WeChat ID" />
        </label>
      </div>
    </fieldset>

    <div class="rfq-consent">
      <label class="consent-checkbox-wrapper">
        <input name="acknowledgement" type="checkbox" required />
        <span class="consent-text">I understand that specifications, certification standards, FOB/EXW pricing, MOQ, and sample delivery timelines require formal project-based engineering confirmation.</span>
      </label>
      <p data-form-error role="alert" hidden>Please complete all required fields (*) before submitting your inquiry.</p>
      <p data-form-status role="status" hidden></p>
      <button class="button button-primary rfq-submit-btn" type="submit">
        <span>Submit RFQ for Review</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>
  </form>

  <section class="rfq-review" data-rfq-review hidden aria-live="polite">
    <div><p class="section-label">Submitted requirement</p><h3>RFQ received by the submission service</h3><p>Formspree accepted your inquiry. Keep this copy for your sourcing record. This confirmation does not confirm a quotation, order or delivery date.</p></div>
    <pre data-rfq-summary tabindex="0"></pre>
    <div class="rfq-review__actions"><button class="button button-primary" type="button" data-copy-rfq>Copy RFQ Summary</button><button class="button button-secondary" type="button" data-edit-rfq>Edit Details</button></div>
    <p class="rfq-copy-status" data-copy-status role="status"></p>
  </section>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-rfq-form]');
    if (!root) return;
    const form = root.querySelector('form');
    const review = root.querySelector('[data-rfq-review]');
    const prefill = root.querySelector('[data-rfq-prefill]');
    const summary = root.querySelector('[data-rfq-summary]');
    const error = root.querySelector('[data-form-error]');
    const status = root.querySelector('[data-form-status]');
    const copyStatus = root.querySelector('[data-copy-status]');
    const labels = {program:'Buying program',stage:'Buying stage',family:'Product family',product:'Reference product',connection:'Connector / port combination',performance:'Required performance',quantity:'Initial quantity',destination:'Destination country',details:'Optional details',customization:'Private label / packaging',sample:'Sample requirement',evidence:'Evidence requested',company:'Company',buyer:'Buyer name',email:'Email',phone:'Phone / messaging',notes:'Requirement',source:'Source page'};
    const params = new URLSearchParams(location.search);
    const field = name => form.elements.namedItem(name);
    const valueOf = name => String(field(name)?.value || '').trim();
    const setValue = (name, value) => { const item = field(name); if (item && value) item.value = value; };
    Object.keys(labels).forEach(name => { if (name === 'buyer') return; const field = form.elements.namedItem(name); const value = params.get(name); if (field && value) field.value = value; });
    if (params.get('family') && !valueOf('program')) setValue('program','Direct product sourcing');
    const programAliases={'Wholesaler':'Wholesale assortment','Importer Distributor':'Import / distribution','Private Label':'Private label','Amazon Seller':'Private label','OEM ODM':'OEM / ODM','Evidence Pack':'Evidence review','Specification Support':'Specification support'};
    const legacyProgram=params.get('buyer')||params.get('project')||params.get('request');
    if (legacyProgram && !params.get('program')) setValue('program',programAliases[legacyProgram]||legacyProgram);
    const familyAliases={'Hub & Dock':'Hub / Dock','DisplayPort':'DisplayPort Cable'};
    if (familyAliases[params.get('family')]) setValue('family',familyAliases[params.get('family')]);
    const request=params.get('request'); if(request && !valueOf('evidence')) setValue('evidence',request);
    const requirement=params.get('requirement'); if(requirement && !valueOf('performance')) setValue('performance',requirement);
    const generatedDetails = [valueOf('connection'), valueOf('performance'), valueOf('customization'), valueOf('evidence')].filter(Boolean).join(' / ');
    if (generatedDetails && !valueOf('notes')) setValue('notes', generatedDetails);
    const hasGeneratedNeed = params.get('program') || params.get('connection') || params.get('customization');
    if (hasGeneratedNeed && prefill) {
      prefill.hidden = false;
      prefill.querySelector('[data-prefill-program]').textContent = valueOf('program') || 'OEM / ODM';
      prefill.querySelector('[data-prefill-connection]').textContent = valueOf('connection') || 'USB cables / HD cables / DP cables / chargers / hubs';
      prefill.querySelector('[data-prefill-customization]').textContent = valueOf('customization') || 'Customized logo, packaging, color, connector configuration and assortment requirements';
    }
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.checkValidity()) { error.hidden=false; form.reportValidity(); return; }
      error.hidden=true;
      const data=new FormData(form); const lines=['RFQ REQUIREMENT',''];
      Object.entries(labels).forEach(([name,label])=>{ const value=String(data.get(name)||'').trim(); if(value) lines.push(`${label}: ${value}`); });
      lines.push('', 'Confirmation: Final specifications and commercial terms require project and evidence review.');
      const summaryText=lines.join('\n');
      form.elements.namedItem('message').value=summaryText;
      status.hidden=false; status.textContent='Sending RFQ...';
      const submitButton=form.querySelector('button[type="submit"]');
      submitButton.disabled=true;
      try {
        const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});
        if(!response.ok) throw new Error('Formspree rejected the submission.');
        summary.textContent=summaryText; form.hidden=true; review.hidden=false; review.scrollIntoView({behavior:'smooth',block:'start'});
        window.dataLayer=window.dataLayer||[]; window.dataLayer.push({event:'rfq_submitted',product_family:data.get('family')});
      } catch (submissionError) {
        status.textContent='Submission failed. Please email kobe202101@gmail.com with the RFQ details, or try again.';
        submitButton.disabled=false;
      }
    });
    root.querySelector('[data-edit-rfq]').addEventListener('click',()=>{review.hidden=true;form.hidden=false;form.querySelector('button[type="submit"]').disabled=false;status.hidden=true;status.textContent='';form.scrollIntoView({behavior:'smooth'});});
    root.querySelector('[data-copy-rfq]').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(summary.textContent);copyStatus.textContent='RFQ summary copied.';}catch{copyStatus.textContent='Copy was blocked. Select the summary and copy it manually.';}});
  })();
</script>
