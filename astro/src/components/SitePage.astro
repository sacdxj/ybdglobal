---
import ProductGrid from './ProductGrid.astro'; import ProductDetail from './ProductDetail.astro'; import DecisionEngine from './DecisionEngine.astro'; import RFQForm from './RFQForm.astro'; import CategoryDirectory from './CategoryDirectory.astro'; import PageIntentBar from './PageIntentBar.astro'; import PageVisualSummary from './PageVisualSummary.astro'; import {findProductByRoute,productsForRoute} from '../data/products';
interface Props{page:any} const {page}=Astro.props; const product=findProductByRoute(page.route); const related=productsForRoute(page.route); const isHome=page.route==='/'; const isProductDirectory=page.route==='/products/'; const isUsbCollection=page.route==='/products/usb-cables/'; const isHdmiCollection=page.route==='/products/hdmi-cables/'; const isDpCollection=page.route==='/products/displayport-cables/'; const isHubCollection=page.route==='/products/hubs-docking/'; const isChargerCollection=page.route==='/products/chargers/'; const isOem=page.route==='/oem-odm/'; const isQuality=page.route==='/quality-factory/'; const isAbout=page.route==='/about-us/'; const isContact=page.route==='/contact/'; const isDirectory=isHome||isProductDirectory; const isProduct=page.pageType==='product'&&product; const isQuote=page.route==='/get-a-quote/'; const isSample=page.route==='/request-sample/'; const hasCta=page.primaryCta&&page.primaryCtaHref;
const routeParts=page.route.split('/').filter(Boolean); const parentHref=routeParts.length>1?`/${routeParts[0]}/`:'/'; const parentLabel=routeParts[0]?.replaceAll('-',' ')||'home';
const breadcrumbLabel=page.route==='/products/'?'Products':page.title;
const role = page.pageType === 'support-policy' ? 'policy' : page.pageType === 'trust-pillar' ? 'trust' : page.pageType === 'resource-pillar' ? 'resource' : page.pageType === 'conversion' ? 'conversion' : page.pageType === 'buyer-solution' || page.pageType === 'commercial-pillar' ? 'program' : page.pageType.includes('collection') || isProduct ? 'product' : 'default';
const panels={
  product:{kicker:'Product selection',title:'Specify first. Validate evidence. Then quote.',items:['Define the connector, port or charging task','Match performance to a selected SKU','Carry the final configuration into RFQ']},
  program:{kicker:'Program planning',title:'Align product, evidence and buying workflow.',items:['Define assortment and destination market','Separate project inputs from supplier claims','Confirm commercial terms after review']},
  trust:{kicker:'Evidence gate',title:'A claim is only as strong as its source.',items:['Map records to the exact model','Check market, scope and validity','Keep missing evidence visible']},
  resource:{kicker:'Selection support',title:'Teach the decision, then route to specification.',items:['One verified task per guide','No unsupported performance shortcuts','Link learning back to a product family']},
  conversion:{kicker:'Structured intake',title:'Turn requirements into a reviewable handoff.',items:['Capture the configuration and quantity','Record market, sample and evidence needs','Confirm terms only after project review']},
  policy:{kicker:'Private-review notice',title:'Operational details remain launch-gated.',items:['Interim information only','No final legal or commercial promise','Approval required before publication']},
  default:{kicker:'Private review',title:'Scope first. Evidence second. Publication last.',items:['Use the approved page role','Expose unresolved requirements','Keep public indexing disabled']}
};
const panel=isHome?{kicker:'Buyer path',title:'Choose. Confirm. Quote.',items:['Choose a product type','Confirm specs and branding','Send quantity for a quote']}:isProductDirectory?{kicker:'Selection path',title:'Start with the product task.',items:['Choose the interface or charging need','Compare the relevant product family','Confirm the selected configuration in RFQ']}:isUsbCollection?{kicker:'Cable selection',title:'Two connectors. One required task.',items:['Identify both connector ends','Separate charging, data and display needs','Choose a model before confirming claims']}:isHdmiCollection?{kicker:'Signal-path brief',title:'Source. Route. Display.',items:['Identify the source and display','Define the target display behaviour','Confirm installation length and route']}:isDpCollection?{kicker:'Display workload',title:'Host. Workload. Monitor.',items:['Identify the source interface and direction','Define the display workload and target','Confirm length, construction and model']}:isHubCollection?{kicker:'Port-matrix brief',title:'Host. Ports. Simultaneous use.',items:['Identify the host and operating system','Build the complete downstream port matrix','Define the devices used at the same time']}:isChargerCollection?{kicker:'Charging-system brief',title:'Devices. Ports. Market.',items:['Identify every device charged together','Define the port mix and output behaviour','Confirm plug format and destination market']}:isSample?{kicker:'Before requesting',title:'Define what the sample must prove.',items:['Select the intended product configuration','Write measurable evaluation criteria','Name the reviewer and approval stage']}:panels[role];
const secondary = isAbout ? {href:'/get-a-quote/',label:'Prepare RFQ'} : role === 'product' ? {href:'/request-sample/',label:'Request Sample'} : role === 'program' || role === 'resource' || role === 'trust' ? {href:'/products/',label:'Review Products'} : role === 'conversion' && !isQuote ? {href:'/products/',label:'Review Products'} : isHome ? {href:'/products/',label:'Explore Products'} : null;
const heroImageByRoute:Record<string,string>={
  '/':'/images/editorial/connectivity-range-hero.webp','/products/':'/images/editorial/connectivity-range-hero.webp','/products/usb-cables/':'/images/products/usb4-140w-20gbps/01-main.webp','/products/hdmi-cables/':'/images/catalog/hdmi-cable-category.webp','/products/displayport-cables/':'/images/products/dp21-16k-80gbps/01-main.webp','/products/hubs-docking/':'/images/catalog/usb-c-hub-category.webp','/products/chargers/':'/images/products/jl-p150-dual-port-charger/01-main.webp','/oem-odm/':'/images/editorial/oem-customization-review.webp','/quality-factory/':'/images/editorial/product-evidence-review.webp','/about-us/':'/images/editorial/connectivity-range-hero.webp','/contact/':'/images/editorial/rfq-preparation-desk.webp','/get-a-quote/':'/images/editorial/rfq-preparation-desk.webp','/request-sample/':'/images/editorial/product-evidence-review.webp'
};
const heroImage=product?.images?.[0]?.src??heroImageByRoute[page.route]??(page.route.startsWith('/solutions/')?'/images/editorial/connectivity-range-hero.webp':null);
const heroEyebrow=isHome?'Connectivity & charging supply':isSample?'Product evaluation':page.pageType.replaceAll('-',' ');
---
{!isHome&&<div class="breadcrumb-band"><nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="page-breadcrumb__separator" aria-hidden="true">›</span>{routeParts.length>1&&<><a href={parentHref}>{parentLabel}</a><span class="page-breadcrumb__separator" aria-hidden="true">›</span></>}<span aria-current="page">{breadcrumbLabel}</span></nav></div>}
<section class:list={['page-hero',`page-hero--${role}`,{'page-hero--product':isProduct,'page-hero--quote':isQuote,'page-hero--sample':isSample,'page-hero--directory':isProductDirectory,'page-hero--usb-collection':isUsbCollection,'page-hero--hdmi-collection':isHdmiCollection,'page-hero--dp-collection':isDpCollection,'page-hero--hub-collection':isHubCollection,'page-hero--commerce':isHome||page.pageType.includes('collection')||page.pageType.includes('pillar')}] } style={heroImage?`--hero-image:url('${heroImage}')`:undefined}><div class="page-hero__content"><p class="eyebrow">{heroEyebrow}</p><h1>{page.title}</h1><p>{page.description}</p>{(hasCta||secondary)&&<div class="hero-actions">{hasCta&&<a class="button button-primary" href={page.primaryCtaHref}>{page.primaryCta}</a>}{secondary&&<a class="button button-secondary" href={secondary.href}>{secondary.label}</a>}</div>}</div><aside class="page-hero__panel"><p class="panel-kicker">{panel.kicker}</p><h2>{panel.title}</h2><ul>{panel.items.map(item=><li>{item}</li>)}</ul></aside></section>
<PageIntentBar audience={page.audience} intent={page.intent} buyerStage={page.buyerStage} proofStatus={page.proofStatus} product={Boolean(isProduct)} home={isHome} directory={isProductDirectory} usbCollection={isUsbCollection} hdmiCollection={isHdmiCollection} dpCollection={isDpCollection} hubCollection={isHubCollection} chargerCollection={isChargerCollection} oem={isOem} quality={isQuality} about={isAbout} contact={isContact}/>
<PageVisualSummary page={page} role={role}/>
{isDirectory&&<CategoryDirectory compact={true} home={isHome}/>} {isHome&&<DecisionEngine/>}{!isDirectory&&!isOem&&(isProduct?<ProductDetail product={product}/>:<ProductGrid products={related} sourceRoute={page.route} title="Configuration starting points." compact={page.pageType.includes('collection')}/>)} {isQuote&&<RFQForm/>}<slot/>
