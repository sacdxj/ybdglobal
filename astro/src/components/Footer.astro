const columns=[
 {title:'Products',links:[['/products/usb-cables/','USB Cables'],['/products/hdmi-cables/','HDMI Cables'],['/products/displayport-cables/','DisplayPort Cables'],['/products/hubs-docking/','Hubs & Docking'],['/products/chargers/','Chargers']]},
 {title:'Work With Us',links:[['/oem-odm/','Customization'],['/get-a-quote/','Request a Quote'],['/request-sample/','Request a Sample'],['/contact/','Contact']]},
