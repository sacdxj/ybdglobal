---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SitePage from '../components/SitePage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('site');
  return pages
    .filter((page) => page.data.route !== '/' && page.data.status !== 'draft')
    .map((page) => ({
      params: { slug: page.data.route.replace(/^\/|\/$/g, '') },
      props: { page },
    }));
}

const { page } = Astro.props;
const isSupportPage = page.data.route.startsWith('/support/');
const isStructuredPage =
  page.data.pageType === 'product' ||
  isSupportPage ||
  page.data.pageType.includes('collection') ||
  page.data.pageType.includes('pillar');

let ContentComponent: any = null;
const shouldRenderContentBody =
  !isStructuredPage ||
  isSupportPage ||
  page.data.pageType.includes('collection') ||
  page.data.pageType.includes('pillar');
if (shouldRenderContentBody) {
  const rendered = await page.render();
  ContentComponent = rendered.Content;
}
---

<MainLayout title={page.data.title} description={page.data.description} keywords={page.data.primaryKeyword}>
  {shouldRenderContentBody ? (
    <SitePage page={page.data}>
      <article class:list={['content-body', { 'support-content': isSupportPage, 'buyer-solution-content': page.data.pageType === 'buyer-solution', 'commercial-pillar-content': page.data.pageType === 'commercial-pillar', 'quote-followup-content': page.data.route === '/get-a-quote/', 'sample-request-content': page.data.route === '/request-sample/', 'product-directory-content': page.data.route === '/products/', 'usb-category-content': page.data.route === '/products/usb-cables/', 'hdmi-category-content': page.data.route === '/products/hdmi-cables/', 'dp-category-content': page.data.route === '/products/displayport-cables/', 'hub-category-content': page.data.route === '/products/hubs-docking/', 'charger-category-content': page.data.route === '/products/chargers/', 'oem-customization-content': page.data.route === '/oem-odm/', 'quality-evidence-content': page.data.route === '/quality-factory/', 'about-platform-content': page.data.route === '/about-us/', 'contact-routing-content': page.data.route === '/contact/' }]}>
        <ContentComponent />
      </article>
    </SitePage>
  ) : (
    <SitePage page={page.data} />
  )}
</MainLayout>
